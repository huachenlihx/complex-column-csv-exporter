{
  "name": "complex-column-csv-exporter",
  "version": "1.0.11",
  "description": "Typed React CSV export button and CSV Blob utility for tabular and complex-column data",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huachenlihx/complex-column-csv-exporter.git"
  },
  "keywords": [
    "csv",
    "export",
    "json",
    "complex-column-csv-exporter",
    "table",
    "huachenlihx"
  ],
  "author": "huachenlihx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/huachenlihx/complex-column-csv-exporter/issues"
  },
  "homepage": "https://github.com/huachenlihx/complex-column-csv-exporter#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12",
    "jest-axe": "^10.0.0",
    "@types/jest-axe": "^3.5.9"
  },
  "dependencies": {
    "papaparse": "^5.5.3"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  }
}
